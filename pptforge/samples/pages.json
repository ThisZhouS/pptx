   {
    "tag": "sp",
    "id": 5,
    "name": "文本占位符 4",
    "text": "与当前工具差异",
    "paras": 1,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 6,
    "name": "文本占位符 5",
    "text": "当前Copilot等工具是“代码补全”，而“CodeCraft AI”是“系统级医生”，能深度分析整个代码仓库，这是与其他工具在功能定位上的显著差异。",
    "paras": 1,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 7,
    "name": "装饰  5",
    "text": "",
    "paras": 0,
    "sizes": []
   },
