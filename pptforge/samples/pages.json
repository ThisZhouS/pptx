    "paras": 0,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 9,
    "name": "文本占位符 8",
    "text": "深度分析代码仓库",
    "paras": 1,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 10,
    "name": "文本占位符 9",
    "text": "“CodeCraft AI”能深度分析整个代码仓库（而非单个文件），理解其架构、数据流和依赖关系，为后续的架构优化和重构提供全面准确的信息。",
    "paras": 1,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 11,
    "name": "装饰  9",
    "text": "",
    "paras": 0,
    "sizes": []
   },
