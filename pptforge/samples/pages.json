   {
    "tag": "sp",
    "id": 5,
    "name": "文本占位符 4",
    "text": "将AI从“编码助手”提升为“架构顾问”",
    "paras": 1,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 6,
    "name": "文本占位符 5",
    "text": "“CodeCraft AI”突破了传统AI仅作为“编码助手”的局限，将其提升为“架构顾问”，实现了软件工程生命周期管理的智能化升级，能为软件架构提供更全面深入的优化与重构建议。",
    "paras": 1,
    "sizes": []
   },
