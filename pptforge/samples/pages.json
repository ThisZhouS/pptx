    "paras": 0,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 13,
    "name": "文本占位符 12",
    "text": "提供重构方案",
    "paras": 1,
    "sizes": []
   },
   {
    "tag": "sp",
    "id": 14,
    "name": "文本占位符 13",
    "text": "该产品能像一位资深架构师一样，自主识别出代码坏味、性能瓶颈和安全漏洞，然后提供经过验证的、可直接合并的架构重构方案，助力代码优化。",
    "paras": 1,
    "sizes": []
   }
  ]
 },
